+    template <typename dist_t>
+    void Hnsw<dist_t>::validateOptimizedIndexHeader() {
+        // These structural scalars are read from the index stream. Validate them before
+        // allocating or indexing with them so a malformed index fails the load instead
+        // of being used.
+        const size_t data_plus_links0_size = memoryPerObject_ * totalElementsStored_;
+        if (totalElementsStored_ == 0 || memoryPerObject_ == 0 ||
+            data_plus_links0_size / memoryPerObject_ != (size_t)totalElementsStored_)
+            throw runtime_error("HNSW optimized index: invalid element count or object stride");
+        if (offsetLevel0_ >= memoryPerObject_ ||
+            offsetData_ > offsetLevel0_ || offsetLevel0_ - offsetData_ < 16 ||
+            (memoryPerObject_ - offsetLevel0_) < sizeof(int))
+            throw runtime_error("HNSW optimized index: invalid section offsets");
+        if ((size_t)enterpointId_ >= (size_t)totalElementsStored_)
+            throw runtime_error("HNSW optimized index: entry point out of range");
+    }
+
+    template <typename dist_t>
+    void Hnsw<dist_t>::validateOptimizedIndexLevel0Links() {
+        // Each level-0 neighbor list is a leading count followed by that many neighbor
+        // ids. The query path uses both as array indices without checking them, so
+        // validate every one here against the allocated bounds.
+        const size_t maxLinkSlots = (memoryPerObject_ - offsetLevel0_) / sizeof(int); // includes count slot
+        for (size_t i = 0; i < totalElementsStored_; i++) {
+            const int *links = (const int *)(data_level0_memory_ + i * memoryPerObject_ + offsetLevel0_);
+            const int cnt = links[0];
+            if (cnt < 0 || (size_t)cnt + 1 > maxLinkSlots)
+                throw runtime_error("HNSW optimized index: level-0 neighbor count out of range");
+            for (int j = 1; j <= cnt; j++) {
+                const int id = links[j];
+                if (id < 0 || (size_t)id >= (size_t)totalElementsStored_)
+                    throw runtime_error("HNSW optimized index: level-0 neighbor id out of range");
+            }
+        }
+    }
+
